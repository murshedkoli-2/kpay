DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=verify-full
NEON_AUTH_BASE_URL=https://YOUR-ENDPOINT.neonauth.REGION.aws.neon.tech/neondb/auth
NEON_OWNER_EMAIL=owner@example.com
# Generate once: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
AUTH_ENCRYPTION_KEY=
# Add this exact origin to Neon Auth's trusted domains.
APP_ORIGIN=http://127.0.0.1:3000
HOST=127.0.0.1
PORT=3000
# Random secret used by /api/cron/webhooks. Set the same value in Vercel.
CRON_SECRET=
