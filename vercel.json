{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/index.mjs": {
      "maxDuration": 120,
      "excludeFiles": "{node_modules/@electric-sql/**,data/**,.env,.env.*,**/*.test.mjs,artifacts/**,agent-android/**}",
      "includeFiles": "{postgres-worker.mjs,database.mjs,node_modules/pg*/**,node_modules/postgres-*/**,node_modules/split2/**,node_modules/xtend/**}"
    }
  },
  "rewrites": [{"source": "/api/:path*", "destination": "/api/index"}],
  "headers": [{"source": "/(.*)", "headers": [
    {"key":"X-Content-Type-Options","value":"nosniff"},
    {"key":"Referrer-Policy","value":"no-referrer"},
    {"key":"Content-Security-Policy","value":"default-src 'self'; style-src 'self'; script-src 'self'; connect-src 'self'; img-src 'self' data:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"}
  ]}],
  "crons": [{"path":"/api/cron/webhooks","schedule":"0 0 * * *"}]
}
